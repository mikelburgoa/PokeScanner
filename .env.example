# OPCIONAL. Lo normal es elegir el proveedor de IA y pegar la clave desde la pestana Ajustes de la app
# (se guarda fuera del proyecto, en tu carpeta de datos). Estas variables sirven como alternativa.
#
# Copia este archivo como ".env" junto al proyecto (o dentro de tu carpeta de datos). NO lo subas a git
# ni lo incluyas en un zip: contiene tus claves.

# Gratis, sin tarjeta: https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_api_key_aqui

# API de pago (distinta de la suscripcion a Claude.ai): https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# API de pago (distinta de ChatGPT Plus): https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
